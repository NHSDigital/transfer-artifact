{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "outDir": "./lib",
    "rootDir": ".",
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "moduleResolution": "node16",
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "declaration": false,
    "sourceMap": true,
    "lib": [
      "es2024",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Iterator",
      "ESNext.Promise"
    ]
  },
  "include": ["src/**/*", "__tests__/**/*", "*.js", "*.mjs", "*.cjs"],
  "exclude": ["node_modules", "lib", "dist"]
}
