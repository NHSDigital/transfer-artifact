{
  "name": "@caas/transfer-artifact",
  "version": "5.0.0",
  "description": "Upload or download a build artifact to an S3 bucket",
  "type": "module",
  "exports": {
    "/": "./dist/index.cjs"
  },
  "scripts": {
    "build": "tsc",
    "release": "esbuild src/upload-or-download.ts --tree-shaking=true --bundle --minify --platform=node --format=cjs --outfile=dist/index.cjs --charset=utf8 --banner:js='//This generated code is run directly by github actions, remeber to rebuild if you change and source code or dependencies' && git add -f dist/",
    "check-all": "concurrently \"npm:format-check\" \"npm:lint\" \"npm:test\" \"npm:build\"",
    "fix": "prettier -w . && eslint --quiet --fix .",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "lint": "eslint .",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.js --testTimeout 10000"
  },
  "keywords": [
    "Actions",
    "GitHub",
    "Artifacts",
    "S3",
    "Upload"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/artifact": "^2.2.2",
    "@actions/core": "^1.11.1",
    "@actions/glob": "^0.5.0",
    "@actions/io": "^1.1.3",
    "@aws-sdk/client-s3": "3.964.0",
    "@aws-sdk/signature-v4-crt": "3.964.0",
    "@aws-sdk/types": "3.957.0",
    "globals": "^17.4.0",
    "p-map": "^7.0.4"
  },
  "devDependencies": {
    "@hyrious/esbuild-plugin-commonjs": "^0.2.6",
    "@jest/types": "^30.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-filenames": "^1.3.2",
    "eslint-plugin-github": "^6.0.0",
    "eslint-plugin-i18n-text": "^1.0.1",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jest": "^29.15.1",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^30.3.0",
    "jest-circus": "^30.3.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
